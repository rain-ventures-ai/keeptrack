{
  "schema": "keeptrack-automation/1",
  "slug": "my-automation",
  "name": "My automation",
  "summary": "Review new local source items",
  "version": "1.0.0",
  "needs": [
    {
      "id": "files.read",
      "why": "Read the automation source",
      "routes": [
        {
          "runtime": "local",
          "how": "Read the local board and source files"
        },
        {
          "runtime": "claude",
          "how": "Confirm read-only access to files.read"
        },
        {
          "runtime": "chatgpt",
          "how": "Confirm read-only access to files.read"
        },
        {
          "runtime": "grok",
          "how": "Confirm read-only access to files.read"
        }
      ]
    }
  ],
  "writes": [
    "proposals"
  ],
  "never": [
    "send-email",
    "delete",
    "spend",
    "external-post",
    "edit-contacts"
  ],
  "every": "1d",
  "flow": [
    {
      "kind": "trigger",
      "title": "Once a day",
      "text": "Runs on the shared automation schedule."
    },
    {
      "kind": "read",
      "title": "Read the source",
      "text": "Say what it reads and that it is read only."
    },
    {
      "kind": "check",
      "title": "Find what is new",
      "text": "A small script, no AI."
    },
    {
      "kind": "agent",
      "title": "Do the work",
      "text": "What the agent does with each new item."
    },
    {
      "kind": "output",
      "title": "Review Inbox",
      "text": "Results wait there as proposals."
    }
  ],
  "check": {
    "file": "check.py",
    "network": false,
    "tools": []
  },
  "config": {
    "notes_dir": {
      "type": "path",
      "required": true,
      "help": "Folder containing Markdown or text notes"
    }
  }
}

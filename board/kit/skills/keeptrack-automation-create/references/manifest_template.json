{
  "schema": "keeptrack-automation/1",
  "slug": "my-automation",
  "name": "My automation",
  "summary": "Review new local source items",
  "version": "1.0.0",
  "needs": [
    {
      "id": "files.read",
      "why": "Read the automation source",
      "routes": [
        {
          "runtime": "local",
          "how": "Read the local board and source files"
        },
        {
          "runtime": "claude",
          "how": "Confirm read-only access to files.read"
        },
        {
          "runtime": "chatgpt",
          "how": "Confirm read-only access to files.read"
        },
        {
          "runtime": "grok",
          "how": "Confirm read-only access to files.read"
        }
      ]
    }
  ],
  "writes": [
    "proposals"
  ],
  "never": [
    "send-email",
    "delete",
    "spend",
    "external-post",
    "edit-contacts"
  ],
  "every": "1d",
  "check": {
    "file": "check.py",
    "network": false,
    "tools": []
  },
  "config": {
    "notes_dir": {
      "type": "path",
      "required": true,
      "help": "Folder containing Markdown or text notes"
    }
  }
}
